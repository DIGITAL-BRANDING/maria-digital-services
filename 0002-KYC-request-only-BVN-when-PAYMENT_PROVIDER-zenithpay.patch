From 8f3ff16aac4fc9f2c9fd014da1e4be1a250335bc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 13:42:47 +0000
Subject: [PATCH 2/2] KYC: request only BVN when PAYMENT_PROVIDER=zenithpay

---
 maria_backend/src/routes/kyc.routes.ts    | 31 ++++++++++++++---------
 maria_backend/src/services/kyc.service.ts | 22 ++++++++++------
 2 files changed, 33 insertions(+), 20 deletions(-)

diff --git a/maria_backend/src/routes/kyc.routes.ts b/maria_backend/src/routes/kyc.routes.ts
index 87c2a04..79b1b10 100644
--- a/maria_backend/src/routes/kyc.routes.ts
+++ b/maria_backend/src/routes/kyc.routes.ts
@@ -31,22 +31,29 @@ kycRoutes.get('/status', async (req, res) => {
 });
 
 kycRoutes.get('/banks', async (_req, res) => {
-  const banks = await listSupportedBanks();
+  // ZenithPay verifies by BVN alone - there is no bank to pick, so return an
+  // empty list instead of letting listSupportedBanks() throw.
+  const banks = env.PAYMENT_PROVIDER === 'zenithpay' ? [] : await listSupportedBanks();
   res.json({ status: true, data: banks });
 });
 
-// NOTE: this endpoint (verifyBvnAndActivateWallet) is Paystack-specific - KatPay's
-// virtual-account creation has no BVN/bank-validation step to mirror it. It only
-// matters if PAYMENT_PROVIDER=paystack AND PAYSTACK_INSTANT_DVA_ENABLED=false, so
-// the app falls back to this BVN-gated path instead of the instant one.
+// BVN-gated activation. With PAYMENT_PROVIDER=zenithpay only `bvn` is requested
+// (bank_code/account_number are not needed and are ignored if sent). With
+// Paystack (and PAYSTACK_INSTANT_DVA_ENABLED=false) bank_code + account_number
+// are still required for the BVN/bank-account cross-check. KatPay doesn't use this.
+const bvnSchema = z.object({ bvn: z.string().trim().length(11, 'BVN must be exactly 11 digits') });
+const bvnWithBankSchema = bvnSchema.extend({
+  bank_code: z.string().trim().min(1, 'bank_code is required'),
+  account_number: z.string().trim().length(10, 'Account number must be exactly 10 digits')
+});
+
 kycRoutes.post('/bvn', async (req, res) => {
-  const body = z
-    .object({
-      bvn: z.string().trim().length(11, 'BVN must be exactly 11 digits'),
-      bank_code: z.string().trim().min(1, 'bank_code is required'),
-      account_number: z.string().trim().length(10, 'Account number must be exactly 10 digits')
-    })
-    .parse(req.body);
+  // Cast: with tsconfig `strict: false` zod infers every field as optional.
+  const body = (env.PAYMENT_PROVIDER === 'zenithpay' ? bvnSchema.parse(req.body) : bvnWithBankSchema.parse(req.body)) as {
+    bvn: string;
+    bank_code?: string;
+    account_number?: string;
+  };
 
   const result = await verifyBvnAndActivateWallet({
     userId: req.user!.id,
diff --git a/maria_backend/src/services/kyc.service.ts b/maria_backend/src/services/kyc.service.ts
index daf90ad..1c541e1 100644
--- a/maria_backend/src/services/kyc.service.ts
+++ b/maria_backend/src/services/kyc.service.ts
@@ -29,16 +29,23 @@ function splitFullName(fullName: string) {
 export async function verifyBvnAndActivateWallet(params: {
   userId: string;
   bvn: string;
-  bankCode: string;
-  accountNumber: string;
+  /** Required for Paystack only (BVN + bank account cross-check). ZenithPay needs just the BVN. */
+  bankCode?: string;
+  accountNumber?: string;
 }) {
   const { userId, bvn, bankCode, accountNumber } = params;
+  const bvnOnly = env.PAYMENT_PROVIDER === 'zenithpay';
 
   if (!/^\d{11}$/.test(bvn)) {
     throw new ApiError(422, 'BVN must be exactly 11 digits', 'INVALID_BVN');
   }
-  if (!/^\d{10}$/.test(accountNumber)) {
-    throw new ApiError(422, 'Account number must be exactly 10 digits', 'INVALID_ACCOUNT_NUMBER');
+  if (!bvnOnly) {
+    if (!bankCode) {
+      throw new ApiError(422, 'bank_code is required', 'INVALID_BANK_CODE');
+    }
+    if (!accountNumber || !/^\d{10}$/.test(accountNumber)) {
+      throw new ApiError(422, 'Account number must be exactly 10 digits', 'INVALID_ACCOUNT_NUMBER');
+    }
   }
 
   const user = await prisma.user.findUniqueOrThrow({ where: { id: userId } });
@@ -57,12 +64,11 @@ export async function verifyBvnAndActivateWallet(params: {
   const { firstName, lastName } = splitFullName(user.fullName);
 
   try {
-    if (env.PAYMENT_PROVIDER === 'zenithpay') {
+    if (bvnOnly) {
       // ZenithPay's single dedicated_account/assign call both validates the BVN
       // and issues the account - no separate resolve/customer/validate steps like
-      // Paystack's below, and bankCode/accountNumber (required by this function's
-      // signature for the Paystack path) are simply unused here: ZenithPay's
-      // endpoint doesn't take or need a bank account to cross-check against.
+      // Paystack's below. Only the BVN is collected - bankCode/accountNumber are
+      // neither required nor used: ZenithPay's endpoint doesn't take a bank account.
       const account = await zenithpayService.assignDedicatedAccount({
         bvn,
         accountName: user.fullName,
-- 
