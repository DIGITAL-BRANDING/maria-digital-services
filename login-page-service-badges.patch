@@ -57,8 +57,32 @@ export default function LoginPage() {
   }
 
   return (
-    <div className="min-h-screen bg-cream px-5 py-10">
-      <div className="mx-auto max-w-md">
+    <div className="relative min-h-screen overflow-hidden bg-cream px-5 py-10">
