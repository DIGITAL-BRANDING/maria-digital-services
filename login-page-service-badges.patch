+      />
+
+      <div className="relative z-10 mx-auto max-w-md">
         <Link to="/" className="mb-8 flex justify-center">
           <Logo />
         </Link>
@@ -155,6 +179,33 @@ export default function LoginPage() {
   );
 }
 
+function ServiceBadge({
+  icon,
+  label,
+  className = '',
+  tilt = '0deg',
+  delay = '0s',
+}: {
+  icon: React.ReactNode;
+  label: string;
+  className?: string;
+  tilt?: string;
+  delay?: string;
+}) {
+  return (
+    <div
+      aria-hidden="true"
