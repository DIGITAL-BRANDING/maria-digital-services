+      />
+      <ServiceBadge
+        icon={<Smartphone size={20} />}
+        label="Airtime Topup"
+        className="right-[8%] top-[20%] hidden lg:flex"
+        tilt="5deg"
+        delay="1.1s"
+      />
+      <ServiceBadge
+        icon={<Fingerprint size={20} />}
+        label="BVN Verification"
+        className="bottom-[10%] left-[10%] hidden lg:flex"
