+import { useEffect, useMemo, useState, type FormEvent } from 'react';
+import { Download, FileText, Loader2 } from 'lucide-react';
+import AppShell from '../../components/AppShell';
+import { api, ApiError } from '../../lib/api';
+import { PinConfirmDialog } from '../../components/PinConfirmDialog';
+import { PageHeader, money, FORM_SECTION_CLASSES, FORM_INPUT_CLASSES, FORM_LABEL_CLASSES } from '../../components/verification/shared';
+
+type TinType = 'individual' | 'corporate';
+type TinPriceRow = { type: TinType; title: string; unitPrice: number; isActive: boolean };
+type TinHistoryEntry = {
+  reference: string;
+  status: string;
+  tin_type: string | null;
+  subject: string | null;
+  identifier: string | null;
+  amount: number;
+  progress_notes: string | null;
+  tin_number: string | null;
+  certificate_pdf_base64: string | null;
+  created_at: string;
+  updated_at: string;
+};
+
+const ORGANIZATION_TYPES = ['Business Name', 'Company', 'Incorporated Trustee', 'Limited Partnership', 'Limited Liability Partnership'];
+const STATUS_LABEL: Record<string, string> = { pending: 'Processing', success: 'Completed', failed: 'Rejected', reversed: 'Refunded' };
+
+export default function TinCertificatePage() {
+  const [prices, setPrices] = useState<TinPriceRow[]>([]);
+  const [tinType, setTinType] = useState<TinType>('individual');
+  const [nin, setNin] = useState('');
+  const [firstName, setFirstName] = useState('');
+  const [surname, setSurname] = useState('');
+  const [dob, setDob] = useState('');
+  const [rcNumber, setRcNumber] = useState('');
+  const [companyName, setCompanyName] = useState('');
+  const [organizationType, setOrganizationType] = useState('');
+  const [showPin, setShowPin] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState('');
+  const [history, setHistory] = useState<TinHistoryEntry[]>([]);
+  const [loadingHistory, setLoadingHistory] = useState(true);
+
+  const priceOf = (type: TinType) => prices.find((p) => p.type === type)?.unitPrice;
+  const selected = useMemo(() => prices.find((p) => p.type === tinType), [prices, tinType]);
+
+  async function loadHistory() {
+    setLoadingHistory(true);
+    try {
+      const result = await api.get<{ status: boolean; data: TinHistoryEntry[] }>('/verification/tin/history');
+      setHistory(result.data ?? []);
+    } catch {
+      setHistory([]);
+    } finally {
+      setLoadingHistory(false);
+    }
+  }
+
+  useEffect(() => {
+    api
+      .get<{ status: boolean; data: TinPriceRow[] }>('/verification/tin/prices')
+      .then((result) => setPrices(result.data ?? []))
+      .catch(() => setPrices([]));
+    void loadHistory();
+  }, []);
+
+  function prepare(event: FormEvent) {
+    event.preventDefault();
+    setMessage('');
+    setShowPin(true);
+  }
+
+  async function submit(pin: string) {
+    setShowPin(false);
+    setBusy(true);
+    setMessage('');
+    try {
+      const payload =
+        tinType === 'individual'
+          ? { tin_type: 'individual', nin, first_name: firstName.trim(), surname: surname.trim(), date_of_birth: dob }
+          : { tin_type: 'corporate', rc_number: rcNumber.trim(), company_name: companyName.trim(), organization_type: organizationType };
+      const result = await api.post<{ status: boolean; message?: string; data?: { reference: string } }>('/verification/tin', { ...payload, pin });
+      if (!result.status) throw new Error(result.message);
+      setMessage(`Request submitted — reference ${result.data?.reference}. Our team will process your TIN and update the status below.`);
+      setNin(''); setFirstName(''); setSurname(''); setDob('');
+      setRcNumber(''); setCompanyName(''); setOrganizationType('');
+      void loadHistory();
+    } catch (error) {
+      setMessage(error instanceof ApiError ? error.message : error instanceof Error ? error.message : 'Request failed.');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const toggleClass = (active: boolean) =>
+    `flex-1 rounded-lg px-3 py-2.5 font-body text-sm font-semibold transition ${active ? 'bg-[#0b2f73] text-white shadow' : 'text-[#0b2f73]/70 hover:bg-blue-50'}`;
+
+  return (
+    <AppShell>
+      <div className="mx-auto max-w-5xl">
+        <PageHeader title="TIN Certificate" subtitle="Request a Tax Identification Number (TIN) certificate for an individual or a registered organisation. Our team processes each request and attaches your certificate here." />
+
+        <section className={FORM_SECTION_CLASSES}>
+          <form onSubmit={prepare}>
+            <div className="flex items-center gap-2 border-b border-blue-200 pb-2">
+              <FileText size={20} className="text-[#0b2f73]" />
+              <h2 className="font-display text-lg font-bold text-[#0b2f73]">Generate TIN</h2>
+            </div>
+
+            <p className="mt-4 rounded-xl bg-blue-50 px-4 py-3 font-body text-sm text-[#0b2f73]">
+              <b>Service Pricing:</b> Individual: <b>{money(priceOf('individual'))}</b> | Corporate: <b>{money(priceOf('corporate'))}</b>
+            </p>
+
+            <p className="mt-5 font-display text-sm font-bold text-[#0b2f73]">Select Verification Type</p>
+            <div className="mt-2 flex gap-1 rounded-xl border border-blue-200 bg-white p-1">
+              <button type="button" className={toggleClass(tinType === 'individual')} onClick={() => setTinType('individual')}>Individual (NIN)</button>
+              <button type="button" className={toggleClass(tinType === 'corporate')} onClick={() => setTinType('corporate')}>Corporate (RC)</button>
+            </div>
+
+            {tinType === 'individual' ? (
+              <div className="mt-5 grid gap-4 sm:grid-cols-2">
+                <label className={`sm:col-span-2 ${FORM_LABEL_CLASSES}`}>NIN Number
+                  <input required inputMode="numeric" pattern="\d{11}" maxLength={11} placeholder="Enter 11-digit NIN" className={`mt-1 ${FORM_INPUT_CLASSES}`} value={nin} onChange={(e) => setNin(e.target.value.replace(/\D/g, ''))} />
+                </label>
+                <label className={FORM_LABEL_CLASSES}>First Name
+                  <input required maxLength={100} className={`mt-1 ${FORM_INPUT_CLASSES}`} value={firstName} onChange={(e) => setFirstName(e.target.value)} />
+                </label>
+                <label className={FORM_LABEL_CLASSES}>Surname
+                  <input required maxLength={100} className={`mt-1 ${FORM_INPUT_CLASSES}`} value={surname} onChange={(e) => setSurname(e.target.value)} />
+                </label>
+                <label className={`sm:col-span-2 ${FORM_LABEL_CLASSES}`}>Date of Birth
+                  <input required type="date" max={new Date().toISOString().slice(0, 10)} className={`mt-1 ${FORM_INPUT_CLASSES}`} value={dob} onChange={(e) => setDob(e.target.value)} />
+                </label>
+              </div>
+            ) : (
+              <div className="mt-5 grid gap-4 sm:grid-cols-2">
+                <label className={FORM_LABEL_CLASSES}>RC Number
+                  <input required maxLength={20} placeholder="e.g. RC1234567" className={`mt-1 ${FORM_INPUT_CLASSES}`} value={rcNumber} onChange={(e) => setRcNumber(e.target.value)} />
+                </label>
+                <label className={FORM_LABEL_CLASSES}>Organization Type
+                  <select required className={`mt-1 ${FORM_INPUT_CLASSES}`} value={organizationType} onChange={(e) => setOrganizationType(e.target.value)}>
+                    <option value="">-- Select --</option>
+                    {ORGANIZATION_TYPES.map((t) => <option key={t} value={t}>{t}</option>)}
+                  </select>
+                </label>
+                <label className={`sm:col-span-2 ${FORM_LABEL_CLASSES}`}>Company Name
+                  <input required minLength={2} maxLength={200} className={`mt-1 ${FORM_INPUT_CLASSES}`} value={companyName} onChange={(e) => setCompanyName(e.target.value)} />
+                </label>
+              </div>
+            )}
+
+            <div className="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
+              <span className="rounded-full bg-gold-500/15 px-4 py-2 text-center font-body text-sm font-bold text-gold-700">Service cost: {money(selected?.unitPrice)}</span>
+              <button disabled={busy || selected?.isActive === false} className="flex w-full items-center justify-center gap-2 rounded-xl bg-gold-500 px-6 py-3 font-display font-semibold text-ink disabled:opacity-60 sm:w-auto">
+                {busy ? <Loader2 size={16} className="animate-spin" /> : 'Generate TIN Now'}
+              </button>
+            </div>
+            {selected?.isActive === false && <p className="mt-3 font-body text-sm text-ember-600">This service is currently unavailable.</p>}
+            {message && <p className="mt-3 rounded-lg bg-blue-50 p-3 font-body text-sm text-[#0b2f73]">{message}</p>}
+          </form>
+
+          <div className="mt-8 border-t border-blue-100 pt-5">
+            <h3 className="font-display text-base font-bold text-[#0b2f73]">Transactions</h3>
+            {loadingHistory ? (
+              <p className="mt-3 font-body text-sm text-[#0b2f73]/70">Loading…</p>
+            ) : history.length === 0 ? (
+              <p className="mt-3 rounded-xl border border-dashed border-blue-200 px-4 py-4 text-center font-body text-sm text-[#0b2f73]/70">No transactions recorded yet.</p>
+            ) : (
+              <div className="mt-3 overflow-x-auto rounded-xl border border-blue-100 bg-blue-50">
+                <table className="w-full text-left font-body text-xs">
+                  <thead>
+                    <tr className="border-b border-blue-100 text-[#0b2f73]/70">
+                      {['Ref ID', 'Type', 'Name', 'ID', 'TIN', 'Amount', 'Status', 'Progress Notes', 'Date', 'Certificate'].map((h) => (
+                        <th key={h} className="whitespace-nowrap px-3 py-2 font-semibold">{h}</th>
+                      ))}
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {history.map((row) => (
+                      <tr key={row.reference} className="border-b border-blue-100 last:border-0">
+                        <td className="whitespace-nowrap px-3 py-2 font-mono text-[#0b2f73]">{row.reference}</td>
+                        <td className="whitespace-nowrap px-3 py-2 text-[#0b2f73]">{row.tin_type === 'corporate' ? 'Corporate' : 'Individual'}</td>
+                        <td className="px-3 py-2 text-[#0b2f73]">{row.subject ?? '—'}</td>
+                        <td className="whitespace-nowrap px-3 py-2 text-[#0b2f73]/70">{row.identifier ?? '—'}</td>
+                        <td className="whitespace-nowrap px-3 py-2 font-mono text-[#0b2f73]">{row.tin_number ?? '—'}</td>
+                        <td className="whitespace-nowrap px-3 py-2 text-[#0b2f73]">{money(row.amount)}</td>
+                        <td className="whitespace-nowrap px-3 py-2">
+                          <span className={`rounded-full px-2 py-1 text-[10px] font-bold ${row.status === 'success' ? 'bg-success-500/15 text-success-600' : row.status === 'pending' ? 'bg-gold-500/15 text-gold-700' : 'bg-ember-500/15 text-ember-600'}`}>
+                            {STATUS_LABEL[row.status] ?? row.status}
+                          </span>
+                        </td>
+                        <td className="max-w-[200px] px-3 py-2 text-[#0b2f73]/70">{row.progress_notes ?? '—'}</td>
+                        <td className="whitespace-nowrap px-3 py-2 text-[#0b2f73]/70">{new Date(row.created_at).toLocaleDateString()}</td>
+                        <td className="whitespace-nowrap px-3 py-2">
+                          {row.certificate_pdf_base64 ? (
+                            <a href={`data:application/pdf;base64,${row.certificate_pdf_base64}`} download={`${row.reference}-tin-certificate.pdf`} className="flex items-center gap-1 rounded-lg bg-gold-500 px-2 py-1.5 font-bold text-ink">
+                              <Download size={12} /> PDF
+                            </a>
+                          ) : (
+                            <span className="text-[#0b2f73]/40">—</span>
+                          )}
+                        </td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+            )}
+          </div>
+        </section>
+      </div>
+
+      <PinConfirmDialog open={showPin} onClose={() => setShowPin(false)} onVerified={submit} />
+    </AppShell>
+  );
+}
