diff --git a/maria_backend/src/admin/tin-certificate.ts b/maria_backend/src/admin/tin-certificate.ts
new file mode 100644
index 0000000..cc51395
--- /dev/null
+++ b/maria_backend/src/admin/tin-certificate.ts
@@ -0,0 +1,223 @@
+import type { Request, Router } from 'express';
+import { TransactionType } from '@prisma/client';
+import { prisma } from '../lib/prisma.js';
+import { completeTinRequest, decryptTinPII, updateTinProgressNotes } from '../services/tin-certificate.service.js';
+import { logAdminAction } from './audit.js';
+import type { AdminSessionUser } from './auth.js';
+
+declare module 'express-session' {
+  interface SessionData {
+    adminUser?: AdminSessionUser;
+  }
+}
+
+function escapeHtml(value: string) {
+  return value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
+}
+
+function paramId(req: Request) {
+  return Array.isArray(req.params.transactionId) ? req.params.transactionId[0] : req.params.transactionId;
+}
+
+/**
+ * Custom admin page for handling a TIN Certificate request while it's PENDING
+ * - reached from the Transaction resource's "manageTinRequest" action (see
+ * components/redirect-to-manage.tsx). Same shape as admin/cac.ts: the admin
+ * sees everything the customer submitted, can leave a customer-visible
+ * progress note, and finally attaches the TIN certificate PDF (and the issued
+ * TIN, optionally), which marks the request SUCCESS. The file is read
+ * client-side with FileReader and posted as base64 in a normal JSON body, so
+ * no file-upload middleware is needed. Rejecting (and refunding) is the
+ * existing generic "reverse" action on the Transaction.
+ */
+export function registerTinCertificateRoutes(router: Router) {
+  router.get('/tin/:transactionId/certificate-pdf', async (req: Request, res) => {
+    const admin = req.session?.adminUser;
+    if (!admin) return res.redirect('/admin/login');
+    if (admin.role === 'SUPPORT') return res.status(403).send('Support admins cannot download TIN certificates.');
+    const tx = await prisma.transaction.findUnique({ where: { id: paramId(req) } });
+    if (!tx || tx.type !== TransactionType.TIN_CERTIFICATE) return res.status(404).send('TIN request not found.');
+    const pii = decryptTinPII(tx);
+    if (!pii?.certificate_pdf_base64) return res.status(404).send('No certificate has been attached to this request yet.');
+    await logAdminAction({ adminId: admin.id, action: 'DOWNLOAD_TIN_CERTIFICATE_PDF', targetType: 'Transaction', targetId: tx.id, metadata: { reference: tx.reference } });
+    res
+      .type('application/pdf')
+      .setHeader('Content-Disposition', `attachment; filename="${tx.reference}-tin-certificate.pdf"`)
+      .send(Buffer.from(pii.certificate_pdf_base64.replace(/^data:[^;]+;base64,/, ''), 'base64'));
+  });
+
+  router.get('/tin/:transactionId/manage', async (req: Request, res) => {
+    const admin = req.session?.adminUser;
+    if (!admin) return res.redirect('/admin/login');
+    if (admin.role === 'SUPPORT') return res.status(403).type('html').send('<p>Support admins cannot manage TIN requests.</p>');
+
+    const tx = await prisma.transaction.findUnique({ where: { id: paramId(req) } });
+    if (!tx || tx.type !== TransactionType.TIN_CERTIFICATE) {
+      return res.status(404).type('html').send('<p>TIN request not found.</p>');
+    }
+
+    await logAdminAction({ adminId: admin.id, action: 'VIEW_TRANSACTION_PII', targetType: 'Transaction', targetId: tx.id, metadata: { reference: tx.reference, via: 'tin_manage' } });
+
+    const metadata = tx.metadata as Record<string, unknown> | null;
+    const pii = decryptTinPII(tx);
+    const tinType = String(metadata?.tin_type ?? '');
+    const progressNotes = typeof metadata?.progress_notes === 'string' ? metadata.progress_notes : '';
+    const isPending = tx.status === 'PENDING';
+    const hasCertificate = typeof pii?.certificate_pdf_base64 === 'string' && pii.certificate_pdf_base64.length > 0;
+
+    const detailRows: [string, string | undefined][] =
+      tinType === 'corporate'
+        ? [
+            ['RC number', pii?.rc_number],
+            ['Company name', pii?.company_name],
+            ['Organization type', pii?.organization_type]
+          ]
+        : [
+            ['NIN', pii?.nin],
+            ['First name', pii?.first_name],
+            ['Surname', pii?.surname],
+            ['Date of birth', pii?.date_of_birth]
+          ];
+
+    res.type('html').send(`<!doctype html>
+<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage TIN request ${escapeHtml(tx.reference)}</title>
+<style>
+  body { font-family: system-ui, sans-serif; max-width: 640px; margin: 40px auto; padding: 0 20px; color: #1a1a1a; }
+  h1 { font-size: 20px; } h2 { font-size: 15px; margin-top: 32px; }
+  .field { margin-top: 8px; }
+  textarea, input[type=file], input[type=text] { width: 100%; box-sizing: border-box; padding: 8px; font: inherit; }
+  textarea { min-height: 90px; }
+  button, .btn { margin-top: 12px; padding: 10px 18px; font: inherit; cursor: pointer; border: 0; border-radius: 6px; background: #6b4f0b; color: #fff; display: inline-block; text-decoration: none; }
+  button:disabled { opacity: .5; cursor: not-allowed; }
+  .meta { color: #666; font-size: 13px; }
+  .status { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }
+  .status.PENDING { background: #fff3cd; color: #7a5b00; }
+  .status.SUCCESS { background: #d4edda; color: #155724; }
+  .status.REVERSED, .status.FAILED { background: #f8d7da; color: #721c24; }
+  #msg { margin-top: 12px; font-size: 14px; }
+  table.details { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
+  table.details td { padding: 7px 4px; border-bottom: 1px solid #eee; vertical-align: top; }
+  table.details td:first-child { color: #666; width: 42%; }
+</style></head>
+<body>
+  <p><a href="/admin/resources/Transaction/records/${tx.id}/show">&larr; Back to transaction</a></p>
+  <h1>TIN request — ${escapeHtml(tx.reference)}</h1>
+  <p class="meta">Status: <span class="status ${tx.status}">${tx.status}</span> · Type: ${escapeHtml(tinType === 'corporate' ? 'Corporate (RC)' : 'Individual (NIN)')}</p>
+
+  <h2>Details to use when obtaining the TIN</h2>
+  <table class="details">
+    ${detailRows.map(([label, value]) => `<tr><td>${escapeHtml(label)}</td><td>${escapeHtml(value ?? '—')}</td></tr>`).join('')}
+  </table>
+
+  ${hasCertificate ? `<p class="meta" style="margin-top:16px">A TIN certificate is already attached${pii?.tin_number ? ` (TIN ${escapeHtml(pii.tin_number)})` : ''}. <a href="/admin/tin/${tx.id}/certificate-pdf">Download it</a>.</p>` : ''}
+
+  <h2>Progress note</h2>
+  <p class="meta">Visible to the customer on their TIN request table. Save this any time while the request is pending.</p>
+  <div class="field"><textarea id="notes" placeholder="e.g. Submitted to FIRS, awaiting TIN issuance">${escapeHtml(progressNotes)}</textarea></div>
+  <button id="saveNotes" ${isPending ? '' : 'disabled'}>Save progress note</button>
+
+  <h2>Complete request</h2>
+  <p class="meta">Upload the TIN certificate once it has been issued. This marks the request SUCCESS and lets the customer download it immediately. To reject and refund instead, use the "Reverse" action on the transaction.</p>
+  <div class="field"><label class="meta">Issued TIN (optional, shown to the customer)</label><input type="text" id="tinNumber" maxlength="40" placeholder="e.g. 12345678-0001" ${isPending ? '' : 'disabled'} /></div>
+  <div class="field"><input type="file" id="certFile" accept="application/pdf" ${isPending ? '' : 'disabled'} /></div>
+  <button id="complete" ${isPending ? '' : 'disabled'}>Mark complete &amp; attach certificate</button>
+
+  <p id="msg"></p>
+
+<script>
+  const txId = ${JSON.stringify(tx.id)};
+  const msg = document.getElementById('msg');
+
+  document.getElementById('saveNotes').addEventListener('click', async () => {
+    msg.textContent = 'Saving…';
+    const res = await fetch('/admin/tin/' + txId + '/manage', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ action: 'notes', progress_notes: document.getElementById('notes').value })
+    });
+    const data = await res.json().catch(() => ({}));
+    msg.textContent = res.ok ? 'Saved.' : (data.error || data.message || 'Failed to save.');
+  });
+
+  document.getElementById('complete').addEventListener('click', async () => {
+    const input = document.getElementById('certFile');
+    const file = input.files && input.files[0];
+    if (!file) { msg.textContent = 'Choose a PDF file first.'; return; }
+    if (file.type !== 'application/pdf') { msg.textContent = 'Please choose a PDF file.'; return; }
+    // Base64 adds ~33%, and the server accepts bodies up to 20mb (see app.ts),
+    // so 14mb raw is the largest file that still fits after conversion.
+    const MAX_RAW_BYTES = 14 * 1024 * 1024;
+    if (file.size > MAX_RAW_BYTES) {
+      msg.textContent = 'That PDF is too large (' + (file.size / (1024 * 1024)).toFixed(1) + 'MB). Please compress it to under 14MB and try again.';
+      return;
+    }
+    msg.textContent = 'Uploading…';
+    const reader = new FileReader();
+    reader.onload = async () => {
+      const base64 = reader.result.split(',')[1];
+      const res = await fetch('/admin/tin/' + txId + '/manage', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'complete', certificate_pdf_base64: base64, tin_number: document.getElementById('tinNumber').value })
+      });
+      const data = await res.json().catch(() => ({}));
+      if (res.ok) {
+        msg.textContent = 'Marked complete. Reloading…';
+        setTimeout(() => window.location.reload(), 800);
+      } else if (res.status === 413) {
+        msg.textContent = 'That PDF is too large for the server to accept. Please compress it and try again.';
+      } else {
+        msg.textContent = data.error || data.message || ('Failed to complete (HTTP ' + res.status + ').');
+      }
+    };
+    reader.readAsDataURL(file);
+  });
+</script>
+</body></html>`);
+  });
+
+  router.post('/tin/:transactionId/manage', async (req: Request, res) => {
+    const admin = req.session?.adminUser;
+    if (!admin) return res.status(401).json({ error: 'Not signed in' });
+    if (admin.role === 'SUPPORT') return res.status(403).json({ error: 'Support admins cannot manage TIN requests.' });
+
+    const tx = await prisma.transaction.findUnique({ where: { id: paramId(req) } });
+    if (!tx || tx.type !== TransactionType.TIN_CERTIFICATE) {
+      return res.status(404).json({ error: 'TIN request not found' });
+    }
+
+    // AdminJS's express-formidable parser exposes normal form/JSON payloads
+    // through `fields` and may leave `req.body` undefined.
+    const body = (req.body ?? (req as Request & { fields?: unknown }).fields ?? {}) as {
+      action?: string;
+      progress_notes?: string;
+      certificate_pdf_base64?: string;
+      tin_number?: string;
+    };
+
+    try {
+      if (body.action === 'notes') {
+        await updateTinProgressNotes({ transactionId: tx.id, notes: String(body.progress_notes ?? '').slice(0, 2000) });
+        await logAdminAction({ adminId: admin.id, action: 'UPDATE_TIN_PROGRESS', targetType: 'Transaction', targetId: tx.id, metadata: { reference: tx.reference } });
+        return res.json({ ok: true });
+      }
+
+      if (body.action === 'complete') {
+        if (!body.certificate_pdf_base64 || typeof body.certificate_pdf_base64 !== 'string') {
+          return res.status(400).json({ error: 'A certificate PDF is required.' });
+        }
+        await completeTinRequest({
+          transactionId: tx.id,
+          certificatePdfBase64: body.certificate_pdf_base64,
+          tinNumber: typeof body.tin_number === 'string' ? body.tin_number.slice(0, 40) : undefined
+        });
+        await logAdminAction({ adminId: admin.id, action: 'COMPLETE_TIN_REQUEST', targetType: 'Transaction', targetId: tx.id, metadata: { reference: tx.reference } });
+        return res.json({ ok: true });
+      }
+
+      return res.status(400).json({ error: 'Unknown action' });
+    } catch (error) {
+      return res.status(422).json({ error: error instanceof Error ? error.message : 'Request failed' });
+    }
+  });
+}
