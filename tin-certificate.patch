@@ -0,0 +1,114 @@
+import { describe, expect, it, vi, beforeEach } from 'vitest';
+
+/** TIN Certificate: manual-processing flow (pricing, submit, history, notes, complete). */
+
+vi.mock('@prisma/client', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@prisma/client')>();
+  const echoEnum = new Proxy({}, { get: (_target, prop) => prop });
+  class PrismaClientKnownRequestError extends Error {
+    code: string;
+    constructor(message: string, opts: { code: string }) {
+      super(message);
+      this.code = opts.code;
+    }
+  }
+  return {
+    ...actual,
+    TransactionStatus: echoEnum,
+    TransactionType: echoEnum,
+    Prisma: { ...((actual as Record<string, unknown>).Prisma as Record<string, unknown>), PrismaClientKnownRequestError }
+  };
+});
+
+vi.mock('../../lib/prisma.js', async () => {
+  const { createFakePrisma } = await import('../../test-utils/fake-prisma.js');
+  const fake = createFakePrisma();
+  return { prisma: fake.api, __resetFakePrisma: () => fake.reset() };
+});
+
+vi.mock('../notification.service.js', () => ({ notifyUser: vi.fn().mockResolvedValue(undefined) }));
+
+const { prisma, __resetFakePrisma } = (await import('../../lib/prisma.js')) as unknown as {
+  prisma: Awaited<ReturnType<typeof import('../../test-utils/fake-prisma.js').createFakePrisma>>['api'];
+  __resetFakePrisma: () => void;
+};
+const { getTinPrice, listTinPrices, submitTinRequest, listTinHistory, updateTinProgressNotes, completeTinRequest, decryptTinPII } =
+  await import('../tin-certificate.service.js');
+
+const INDIVIDUAL = { nin: '62021151655', first_name: 'Sunusi', surname: 'Usama', date_of_birth: '1994-05-01' };
+const CORPORATE = { rc_number: 'RC1234567', company_name: 'Amana Ltd', organization_type: 'Company' as const };
+
+let n = 0;
+async function seedUser(balanceNaira: number) {
+  n += 1;
+  const id = `user-${n}`;
+  await prisma.user.create({
+    data: { id, walletBalanceKobo: BigInt(Math.round(balanceNaira * 100)), fullName: `T ${n}`, email: `t${n}@example.test`, phone: `+23480000${String(n).padStart(4, '0')}`, referralCode: `REF${n}` }
+  });
+  return id;
+}
+async function balanceOf(id: string) {
+  return Number((await prisma.user.findUniqueOrThrow({ where: { id } })).walletBalanceKobo) / 100;
+}
+
+beforeEach(() => __resetFakePrisma());
+
+describe('TIN pricing', () => {
+  it('defaults to 400 / 500', async () => {
+    expect((await getTinPrice('individual')).unitPrice).toBe(400);
+    expect((await getTinPrice('corporate')).unitPrice).toBe(500);
+  });
+  it('honours admin override and rejects when inactive', async () => {
+    await getTinPrice('individual');
+    await prisma.servicePricing.update({ where: { service: 'TIN_INDIVIDUAL' }, data: { sellingPriceKobo: 650_00n } });
+    expect((await getTinPrice('individual')).unitPrice).toBe(650);
+    await prisma.servicePricing.update({ where: { service: 'TIN_INDIVIDUAL' }, data: { isActive: false } });
+    await expect(getTinPrice('individual')).rejects.toThrow(/unavailable/i);
+    expect((await listTinPrices()).map((p) => p.type).sort()).toEqual(['corporate', 'individual']);
+  });
+});
+
+describe('TIN request lifecycle', () => {
+  it('debits, stays PENDING, seals PII and exposes only a masked identifier', async () => {
+    const userId = await seedUser(1000);
+    const r = await submitTinRequest({ userId, type: 'individual', details: INDIVIDUAL });
+    expect(await balanceOf(userId)).toBe(600);
+    const tx = await prisma.transaction.findUnique({ where: { reference: r.reference } });
+    expect(tx?.status).toBe('PENDING');
+    expect(JSON.stringify(tx?.metadata)).not.toContain('62021151655');
+    expect(decryptTinPII(tx!)?.nin).toBe('62021151655');
+    const [row] = await listTinHistory(userId);
+    expect(row.identifier).toBe('NIN ••••1655');
+    expect(row.subject).toBe('Sunusi Usama');
+    expect(row.status).toBe('pending');
+  });
+
+  it('corporate uses 500 and RC mask', async () => {
+    const userId = await seedUser(1000);
+    await submitTinRequest({ userId, type: 'corporate', details: CORPORATE });
+    expect(await balanceOf(userId)).toBe(500);
+    expect((await listTinHistory(userId))[0].identifier).toBe('RC ••••4567');
+  });
+
+  it('rejects when balance is insufficient', async () => {
+    const userId = await seedUser(100);
+    await expect(submitTinRequest({ userId, type: 'individual', details: INDIVIDUAL })).rejects.toThrow();
+    expect(await balanceOf(userId)).toBe(100);
+  });
+
+  it('saves notes, completes with certificate and TIN, and refuses a second completion', async () => {
+    const userId = await seedUser(1000);
+    const r = await submitTinRequest({ userId, type: 'individual', details: INDIVIDUAL });
+    const tx = await prisma.transaction.findUniqueOrThrow({ where: { reference: r.reference } });
+    await updateTinProgressNotes({ transactionId: tx.id, notes: 'Submitted to FIRS' });
+    expect((await listTinHistory(userId))[0].progress_notes).toBe('Submitted to FIRS');
+
+    await completeTinRequest({ transactionId: tx.id, certificatePdfBase64: 'JVBERi0=', tinNumber: ' 1234-0001 ' });
+    const [row] = await listTinHistory(userId);
+    expect(row.status).toBe('success');
+    expect(row.tin_number).toBe('1234-0001');
+    expect(row.certificate_pdf_base64).toBe('JVBERi0=');
+    expect(decryptTinPII(await prisma.transaction.findUniqueOrThrow({ where: { id: tx.id } }))?.nin).toBe('62021151655');
+    await expect(completeTinRequest({ transactionId: tx.id, certificatePdfBase64: 'x' })).rejects.toThrow(/pending/i);
+  });
+});
diff --git a/maria_backend/src/services/tin-certificate.service.ts b/maria_backend/src/services/tin-certificate.service.ts
new file mode 100644
index 0000000..3471012
--- /dev/null
+++ b/maria_backend/src/services/tin-certificate.service.ts
@@ -0,0 +1,245 @@
+import { Prisma, TransactionStatus, TransactionType } from '@prisma/client';
+import { koboToNaira } from '../lib/money.js';
+import { sealPII, openPII, mergeSealedPII } from '../lib/pii.js';
+import { prisma } from '../lib/prisma.js';
+import { ApiError } from '../middleware/error.js';
+import { debitWallet } from './wallet.service.js';
+
+/**
+ * TIN Certificate - Tax Identification Number for an individual (by NIN) or a
+ * registered organisation (by RC number).
+ *
+ * No provider API exists for this, so it follows the same manual pattern as
+ * CAC registration (cac.service.ts): the customer is debited at submission,
+ * the transaction sits PENDING, and an admin obtains the TIN by hand. From
+ * the "manage" page (admin/tin-certificate.ts) the admin can:
+ *   - save a progress note, shown to the customer on their request table;
+ *   - mark the request complete, attaching the TIN certificate PDF (and,
+ *     optionally, the issued TIN) which the customer can then download.
+ * A request that can't be fulfilled is rejected with the existing generic
+ * "reverse" admin action, which refunds the wallet.
+ *
+ * Everything the customer supplies (NIN, date of birth, RC number, company
+ * name...) is sealed with sealPII, never stored in plain metadata.
+ */
+export const TIN_TYPES = ['individual', 'corporate'] as const;
+export type TinType = (typeof TIN_TYPES)[number];
+
+export const TIN_ORGANIZATION_TYPES = [
+  'Business Name',
+  'Company',
+  'Incorporated Trustee',
+  'Limited Partnership',
+  'Limited Liability Partnership'
+] as const;
+export type TinOrganizationType = (typeof TIN_ORGANIZATION_TYPES)[number];
+
+/** Default selling prices - only used to create a price row the first time it's looked up.
+ *  Admins change the real price from /admin/bulk-pricing ("Set exact service prices"). */
+const TIN_CONFIG: Record<TinType, { title: string; price: number }> = {
+  individual: { title: 'TIN Certificate — Individual (NIN)', price: 400 },
+  corporate: { title: 'TIN Certificate — Corporate (RC)', price: 500 }
+};
+
+export type TinIndividualDetails = { nin: string; first_name: string; surname: string; date_of_birth: string };
+export type TinCorporateDetails = { rc_number: string; company_name: string; organization_type: TinOrganizationType };
+export type TinDetails = TinIndividualDetails | TinCorporateDetails;
+
+function serviceKeyFor(type: TinType) {
+  return `TIN_${type.toUpperCase()}`;
+}
+
+function priceToKobo(amount: number) {
+  return BigInt(Math.round(amount * 100));
+}
+
+/** Same plain-findUnique-then-conditional-create shape as every other pricing
+ *  lookup here - never resets an admin's already-configured price. */
+async function getOrCreatePricingRow(type: TinType) {
+  const config = TIN_CONFIG[type];
+  const service = serviceKeyFor(type);
+  const existing = await prisma.servicePricing.findUnique({ where: { service } });
+  if (existing) return existing;
+
+  try {
+    return await prisma.servicePricing.create({
+      data: { service, provider: 'manual', label: config.title, providerCostKobo: priceToKobo(config.price) }
+    });
+  } catch (error) {
+    if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') {
+      return prisma.servicePricing.findUniqueOrThrow({ where: { service } });
+    }
+    throw error;
+  }
+}
+
+export async function getTinPrice(type: TinType) {
+  const row = await getOrCreatePricingRow(type);
+  if (!row.isActive) {
+    throw new ApiError(422, `${row.label} is currently unavailable`, 'SERVICE_INACTIVE');
+  }
+  const unitKobo = row.sellingPriceKobo ?? row.providerCostKobo;
+  return { unitPrice: koboToNaira(unitKobo), providerCostKobo: row.providerCostKobo };
+}
+
+/** Public price list - never throws on a disabled service. */
+export async function listTinPrices() {
+  const rows = await Promise.all(TIN_TYPES.map((type) => getOrCreatePricingRow(type)));
+  return rows.map((row, index) => ({
+    type: TIN_TYPES[index],
+    title: TIN_CONFIG[TIN_TYPES[index]].title,
+    unitPrice: koboToNaira(row.sellingPriceKobo ?? row.providerCostKobo),
+    isActive: row.isActive
+  }));
+}
+
+function createTinReference() {
+  return `TIN-${new Date().toISOString().slice(0, 10).replace(/-/g, '')}-${Math.random().toString(36).slice(2, 8).toUpperCase()}`;
+}
+
+/** "62021151655" -> "NIN ••••1655" - enough for the customer to recognise their own request, never the full number. */
+function maskIdentifier(label: string, value: string) {
+  const trimmed = value.trim();
+  return trimmed.length <= 4 ? `${label} ${trimmed}` : `${label} ••••${trimmed.slice(-4)}`;
+}
+
+function describeSubject(type: TinType, details: TinDetails) {
+  if (type === 'individual') {
+    const d = details as TinIndividualDetails;
+    return { subject: [d.first_name, d.surname].filter(Boolean).join(' '), identifier: maskIdentifier('NIN', d.nin) };
+  }
+  const d = details as TinCorporateDetails;
+  return { subject: d.company_name, identifier: maskIdentifier('RC', d.rc_number) };
+}
+
+export type SubmitTinResult = { reference: string; balanceAfter: number };
+
+export async function submitTinRequest(params: {
+  userId: string;
+  type: TinType;
+  details: TinDetails;
+  idempotencyKey?: string;
+}): Promise<SubmitTinResult> {
+  const config = TIN_CONFIG[params.type];
+  const price = await getTinPrice(params.type);
+  const service = serviceKeyFor(params.type);
+  const { subject, identifier } = describeSubject(params.type, params.details);
+
+  const debit = await debitWallet({
+    userId: params.userId,
+    amount: price.unitPrice,
+    type: TransactionType.TIN_CERTIFICATE,
+    description: config.title,
+    metadata: {
+      service,
+      tin_type: params.type,
+      unit_price: price.unitPrice,
+      progress_notes: null,
+      tracking_ref: createTinReference(),
+      // Display-only summary shown on the customer's request table. The full
+      // identifiers live only inside the sealed `pii` below.
+      subject,
+      identifier,
+      pii: sealPII({ ...params.details })
+    } as Prisma.InputJsonValue,
+    idempotencyKey: params.idempotencyKey,
+    // Nothing was paid upstream yet - an admin obtains the TIN by hand.
+    costKobo: price.providerCostKobo
+  });
+
+  return { reference: debit.reference, balanceAfter: debit.balanceAfter };
+}
+
+export type TinHistoryEntry = {
+  reference: string;
+  status: string;
+  tin_type: string | null;
+  subject: string | null;
+  identifier: string | null;
+  amount: number;
+  progress_notes: string | null;
+  tin_number: string | null;
+  certificate_pdf_base64: string | null;
+  created_at: string;
+  updated_at: string;
+};
+
+type TinPII = Partial<TinIndividualDetails & TinCorporateDetails> & {
+  tin_number?: string;
+  certificate_pdf_base64?: string;
+};
+
+/** Every status is listed - a TIN request can take days, so the customer needs to track it while it is still PENDING. */
+export async function listTinHistory(userId: string) {
+  const transactions = await prisma.transaction.findMany({
+    where: { userId, type: TransactionType.TIN_CERTIFICATE },
+    orderBy: { createdAt: 'desc' },
+    take: 50
+  });
+
+  return transactions.map((transaction): TinHistoryEntry => {
+    const metadata = transaction.metadata as Record<string, unknown> | null;
+    const pii = openPII<TinPII>(metadata?.pii);
+    return {
+      reference: transaction.reference,
+      status: transaction.status.toLowerCase(),
+      tin_type: typeof metadata?.tin_type === 'string' ? metadata.tin_type : null,
+      subject: typeof metadata?.subject === 'string' ? metadata.subject : null,
+      identifier: typeof metadata?.identifier === 'string' ? metadata.identifier : null,
+      amount: koboToNaira(transaction.amountKobo),
+      progress_notes: typeof metadata?.progress_notes === 'string' ? metadata.progress_notes : null,
+      tin_number: typeof pii?.tin_number === 'string' ? pii.tin_number : null,
+      certificate_pdf_base64: typeof pii?.certificate_pdf_base64 === 'string' ? pii.certificate_pdf_base64 : null,
+      created_at: transaction.createdAt.toISOString(),
+      updated_at: transaction.updatedAt.toISOString()
+    };
+  });
+}
+
+async function findTinTransaction(transactionId: string) {
+  const transaction = await prisma.transaction.findUnique({ where: { id: transactionId } });
+  if (!transaction || transaction.type !== TransactionType.TIN_CERTIFICATE) {
+    throw new ApiError(404, 'TIN transaction not found', 'TRANSACTION_NOT_FOUND');
+  }
+  return transaction;
+}
+
+/** Admin-only: update the customer-visible progress note without changing status. */
+export async function updateTinProgressNotes(params: { transactionId: string; notes: string }) {
+  const transaction = await findTinTransaction(params.transactionId);
+  const metadata = (transaction.metadata as Record<string, unknown> | null) ?? {};
+  await prisma.transaction.update({
+    where: { id: transaction.id },
+    data: { metadata: { ...metadata, progress_notes: params.notes } as Prisma.InputJsonValue }
+  });
+}
+
+/** Admin-only: attach the TIN certificate (and optionally the issued TIN) and mark the request SUCCESS. */
+export async function completeTinRequest(params: { transactionId: string; certificatePdfBase64: string; tinNumber?: string }) {
+  const transaction = await findTinTransaction(params.transactionId);
+  if (transaction.status !== TransactionStatus.PENDING) {
+    throw new ApiError(422, 'Only a pending TIN request can be marked complete', 'INVALID_STATUS');
+  }
+
+  const metadata = (transaction.metadata as Record<string, unknown> | null) ?? {};
+  const tinNumber = params.tinNumber?.trim();
+  await prisma.transaction.update({
+    where: { id: transaction.id },
+    data: {
+      status: TransactionStatus.SUCCESS,
+      metadata: {
+        ...metadata,
+        pii: mergeSealedPII(metadata.pii, {
+          certificate_pdf_base64: params.certificatePdfBase64,
+          ...(tinNumber ? { tin_number: tinNumber } : {})
+        })
+      } as Prisma.InputJsonValue
+    }
+  });
+}
+
+/** Decrypts the sealed PII (applicant details, certificate) for the admin's manage page. Never call from a user-facing endpoint. */
+export function decryptTinPII(transaction: { metadata: unknown }) {
+  const metadata = transaction.metadata as Record<string, unknown> | null;
+  return openPII<TinPII>(metadata?.pii);
+}
