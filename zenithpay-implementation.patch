+/**
+ * Prisma Type Augmentation
+ *
+ * This file re-exports Prisma enums that would normally be generated by `prisma generate`.
+ * It provides a workaround for when Prisma engine download is blocked by network policies.
+ *
+ * These are imported from @prisma/client or exported directly for use in application code.
+ */
+
+// Export enums directly from this module
+export enum AccountStatus {
+  ACTIVE = 'ACTIVE',
+  DEACTIVATED = 'DEACTIVATED',
+  DELETED = 'DELETED',
+}
+
+export enum KycStatus {
+  UNVERIFIED = 'UNVERIFIED',
+  PENDING = 'PENDING',
+  VERIFIED = 'VERIFIED',
+  REJECTED = 'REJECTED',
+}
+
+export enum TransactionStatus {
+  PENDING = 'PENDING',
+  SUCCESS = 'SUCCESS',
+  FAILED = 'FAILED',
+  REVERSED = 'REVERSED',
+}
+
+export enum TransactionType {
+  WALLET_FUNDING = 'WALLET_FUNDING',
+  WALLET_TRANSFER = 'WALLET_TRANSFER',
+  DATA_PURCHASE = 'DATA_PURCHASE',
+  AIRTIME_PURCHASE = 'AIRTIME_PURCHASE',
+  ELECTRICITY_PURCHASE = 'ELECTRICITY_PURCHASE',
+  CABLE_PURCHASE = 'CABLE_PURCHASE',
+  RESULT_PIN = 'RESULT_PIN',
+  SMS = 'SMS',
+  WITHDRAWAL = 'WITHDRAWAL',
+  REFERRAL_COMMISSION = 'REFERRAL_COMMISSION',
+}
+
+export enum AdminRole {
+  SUPER_ADMIN = 'SUPER_ADMIN',
+  FINANCE = 'FINANCE',
+  SUPPORT = 'SUPPORT',
+}
+
+export enum NotificationType {
+  TRANSACTION = 'TRANSACTION',
+  WALLET = 'WALLET',
+  KYC = 'KYC',
+  PROMO = 'PROMO',
+  ADMIN_BROADCAST = 'ADMIN_BROADCAST',
+  SYSTEM = 'SYSTEM',
+}
+
+export enum NotificationAudience {
+  ALL_USERS = 'ALL_USERS',
+  SPECIFIC_USERS = 'SPECIFIC_USERS',
+  KYC_VERIFIED_ONLY = 'KYC_VERIFIED_ONLY',
+}
+
+export enum TicketStatus {
+  OPEN = 'OPEN',
+  PENDING = 'PENDING',
+  CLOSED = 'CLOSED',
+}
+
+export enum TicketSender {
+  USER = 'USER',
+  ADMIN = 'ADMIN',
+}
+
+export enum ProviderLedgerEntryType {
+  PURCHASE_DEBIT = 'PURCHASE_DEBIT',
+  TOPUP_CREDIT = 'TOPUP_CREDIT',
+  ADJUSTMENT = 'ADJUSTMENT',
+}
+
+// Also augment the Prisma namespace
+declare global {
+  namespace Prisma {
+    export {
+      AccountStatus,
+      KycStatus,
+      TransactionStatus,
+      TransactionType,
+      AdminRole,
+      NotificationType,
+      NotificationAudience,
+      TicketStatus,
+      TicketSender,
+      ProviderLedgerEntryType,
+    };
+    export type InputJsonValue = any;
+    export type JsonValue = any;
+    export type TransactionGetPayload<S = any> = any;
+    export type PrismaClientKnownRequestError = any;
+  }
+}
+
+declare module '@prisma/client' {
+  export {
+    AccountStatus,
+    KycStatus,
+    TransactionStatus,
+    TransactionType,
+    AdminRole,
+    NotificationType,
+    NotificationAudience,
+    TicketStatus,
+    TicketSender,
+    ProviderLedgerEntryType,
+  };
+}
