index 0000000..e380f81
--- /dev/null
+++ b/maria_backend/src/types/prisma-client-augment.d.ts
@@ -0,0 +1,46 @@
+/**
+ * Module Augmentation for @prisma/client
+ *
+ * Adds missing type exports that would normally be generated by `prisma generate`.
+ */
+
+import {
+  AccountStatus,
+  KycStatus,
+  TransactionStatus,
+  TransactionType,
+  AdminRole,
+  NotificationType,
+  NotificationAudience,
+  TicketStatus,
+  TicketSender,
+  ProviderLedgerEntryType,
+} from './prisma-enums.js';
+
+declare module '@prisma/client' {
+  export {
+    AccountStatus,
+    KycStatus,
+    TransactionStatus,
+    TransactionType,
+    AdminRole,
+    NotificationType,
+    NotificationAudience,
+    TicketStatus,
+    TicketSender,
+    ProviderLedgerEntryType,
+  };
+
+  namespace Prisma {
+    export type InputJsonValue = unknown;
+    export type JsonValue = unknown;
+    export type NullableJsonNullValueInput = unknown;
+    export type TransactionGetPayload<S = any> = any;
+
+    export class PrismaClientKnownRequestError extends Error {
+      code: string;
+      meta?: any;
+      constructor(message: string, code: string, meta?: any);
+    }
+  }
+}
